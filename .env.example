# Copy to .env at the repo root. Every app reads this file in development.
# Database: a Neon project (two databases: freelo, freelo_test), or docker/compose.dev.yml on Linux.

NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/freelo?sslmode=verify-full
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/freelo_test?sslmode=verify-full

# API
API_PORT=3001
WEB_URL=http://localhost:5173

# Auth (S1). Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Public origin. The web dev server proxies /api to the API, so this is the web URL.
BETTER_AUTH_URL=http://localhost:5173
# Optional: Google sign-in (create an OAuth client in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: "console" (printed in the worker log), "smtp" (Mailpit, docker on Linux) or "resend" (production)
EMAIL_PROVIDER=console
EMAIL_FROM="FreeLo <noreply@freelo.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Web (Vite exposes only VITE_* variables). The API is reached through the /api proxy.
VITE_GOOGLE_ENABLED=false
