# Copy to .env at the repo root. Every app reads this file in development.
# Values below match docker/compose.dev.yml.

NODE_ENV=development

# Database
DATABASE_URL=postgres://freelo:freelo@localhost:5432/freelo
TEST_DATABASE_URL=postgres://freelo:freelo@localhost:5432/freelo_test

# API
API_PORT=3001
WEB_URL=http://localhost:5173

# Auth (S1). Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Email: "smtp" (Mailpit in dev) or "resend" (production)
EMAIL_PROVIDER=smtp
EMAIL_FROM="FreeLo <noreply@freelo.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Object storage (MinIO in dev, R2/S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=freelo-dev
S3_ACCESS_KEY_ID=freelo
S3_SECRET_ACCESS_KEY=freelo-secret

# Web (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:3001
