# Copy to .env at the repo root. Every app reads this file in development.
# Values below match docker/compose.dev.yml. Object storage settings arrive in S2.

NODE_ENV=development

# Database
DATABASE_URL=postgres://freelo:freelo@localhost:5432/freelo
TEST_DATABASE_URL=postgres://freelo:freelo@localhost:5432/freelo_test

# API
API_PORT=3001
WEB_URL=http://localhost:5173

# Auth (S1). Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# Email: "smtp" (Mailpit in dev) or "resend" (production)
EMAIL_PROVIDER=smtp
EMAIL_FROM="FreeLo <noreply@freelo.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# Web (Vite exposes only VITE_* variables)
VITE_API_URL=http://localhost:3001
